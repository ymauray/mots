# https://EditorConfig.org
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

# Même règle que .gitattributes : CRLF dans le répertoire de travail (Windows / Visual Studio)
[*.{cs,xaml,csproj,slnx,md,gitignore,gitattributes}]
end_of_line = crlf

[*.{csproj,slnx,yml,yaml,json}]
indent_size = 2
